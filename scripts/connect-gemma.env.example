# connect-gemma 설정 예시 (MacBook 로컬에만 두고 커밋 금지 → connect-gemma.env 로 복사)
# Mac mini 의 Tailscale 호스트명 또는 tailnet IP (tailscale status 로 확인)
GEMMA_SSH_HOST=taeukkim-macmini
# Mac mini 사용자명
GEMMA_SSH_USER=taeuk
# LOCAL_PORT: MacBook 로컬 포트. 3000이 이미 쓰이면 3001 등으로 바꾼다 → 브라우저는 http://127.0.0.1:<LOCAL_PORT>
LOCAL_PORT=3001
# REMOTE_PORT: Mac mini Open WebUI 포트 (고정 3000)
REMOTE_PORT=3000
