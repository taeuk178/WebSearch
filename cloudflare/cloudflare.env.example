# Cloudflare Tunnel 설정 — cloudflare/cloudflare.env 로 복사해 쓴다(git 미추적).
#
#   cp cloudflare/cloudflare.env.example cloudflare/cloudflare.env
#
# 비밀값은 여기 두지 않는다. 터널 자격증명은 ~/.cloudflared/<TUNNEL_ID>.json 에,
# 계정 인증서는 ~/.cloudflared/cert.pem 에 cloudflared 가 직접 만든다.

# 구매한 도메인 (Cloudflare 에 zone 으로 등록된 것)
CF_DOMAIN=imprint.asia

# Open WebUI 를 노출할 호스트명. 이 이름만 공개된다.
CF_HOSTNAME=ai.imprint.asia

# 터널 이름. `cloudflared tunnel list` 에 이 이름으로 나온다.
CF_TUNNEL_NAME=gemma

# 터널이 붙을 로컬 서비스. **3000(Open WebUI) 외에는 넣지 않는다.**
# 8080(MLX)·8888(SearXNG) 을 넣으면 인증 없는 모델 API 가 공개된다.
CF_SERVICE_URL=http://127.0.0.1:3000

# 터널 프로토콜. 기본 auto(QUIC 우선, 실패 시 http2).
# 사내망이 UDP 7844 를 막으면 http2 로 고정한다.
CF_PROTOCOL=auto
