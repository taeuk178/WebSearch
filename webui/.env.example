# Open WebUI 환경 변수 예시 (비밀값 제외)
# 실제 사용: 이 파일을 webui/.env 로 복사한 뒤 WEBUI_SECRET_KEY 를 채운다.
# 서버 바인딩(127.0.0.1)은 run-webui.sh 의 --host 로 강제하므로 여기서 지정하지 않는다.

# --- 모델 API 연결 (Mac mini 루프백의 MLX 서버) ---
ENABLE_OPENAI_API=True
OPENAI_API_BASE_URL=http://127.0.0.1:8080/v1
OPENAI_API_KEY=not-needed
ENABLE_OLLAMA_API=False

# --- 인증 ---
WEBUI_AUTH=True
# 최초 관리자 계정을 만들 때만 True 로 두고, 만든 뒤 False 로 바꾼다.
ENABLE_SIGNUP=False
DEFAULT_USER_ROLE=pending
# 비밀값: 반드시 webui/.env 에서 임의 값으로 채운다. (예: python3 -c "import secrets;print(secrets.token_hex(32))")
# WEBUI_SECRET_KEY=

# --- 웹 검색 (Legacy, 스니펫 직접 전달 / 임베딩·벡터·전체페이지 수집 없음) ---
ENABLE_WEB_SEARCH=True
# 자체 호스팅 SearXNG 를 검색 백엔드로 쓴다 (searxng/run-searxng.sh).
# ddgs 는 다른 검색엔진을 비공식 스크래핑하는 라이브러리라 제공자 변화에
# 그대로 깨진다(0건 반환 시 DDGSException 이 전파되어 검색이 400 에러로 끝남).
# SearXNG 는 여러 엔진을 집계하고 API 키도, 외부 대행 서비스도 필요 없다.
WEB_SEARCH_ENGINE=searxng
SEARXNG_QUERY_URL=http://127.0.0.1:8888/search
SEARXNG_LANGUAGE=all
WEB_SEARCH_RESULT_COUNT=5
WEB_SEARCH_CONCURRENT_REQUESTS=1
BYPASS_WEB_SEARCH_EMBEDDING_AND_RETRIEVAL=True
BYPASS_WEB_SEARCH_WEB_LOADER=True

# --- 사용자 요청 외 추가 LLM 호출 비활성화 ---
ENABLE_AUTOCOMPLETE_GENERATION=False
ENABLE_TAGS_GENERATION=False
ENABLE_TITLE_GENERATION=False
ENABLE_FOLLOW_UP_GENERATION=False

# --- 설정을 env 로 결정적으로 제어 (DB에 config를 영속화하지 않음) ---
ENABLE_PERSISTENT_CONFIG=False

# 검색어 생성 활성화. 사용자 발화를 그대로 검색어로 쓰면("안녕? ...는 무슨 내용인지
# 알려줘") 대화체 표현이 검색 품질을 크게 깎는다. 추가 LLM 호출이 붙지만
# thinking 을 꺼둔 상태라 비용이 작다.
ENABLE_SEARCH_QUERY_GENERATION=True

# --- 대화 비영속: 임시 대화 강제 (대화 내용 영구 저장 안 함) ---
USER_PERMISSIONS_CHAT_TEMPORARY=True
USER_PERMISSIONS_CHAT_TEMPORARY_ENFORCED=True

# --- 기본 평가용 Arena 모델 숨김 (Qwen3.6 35B 만 노출) ---
ENABLE_EVALUATION_ARENA_MODELS=False

# 새 대화 기본 모델 (연결 모델 id = 모델 절대경로; seed-model.sh의 BASE_MODEL과 동일)
DEFAULT_MODELS=/Users/<user>/gemma-server/models/Qwen3.6-35B-A3B-4bit

# --- 코드 인터프리터/실행 제거 (웹 검색 전용 사용) ---
ENABLE_CODE_INTERPRETER=False
ENABLE_CODE_EXECUTION=False
